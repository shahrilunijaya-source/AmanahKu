includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
    # Runtime magic PHPStan can't see statically without extra stubs. Kept deliberately
    # tight — this is the baseline to grow the level from, not a blanket silencer.
    ignoreErrors:
        # Eloquent dynamic props / query-builder returns are heavily used app-wide.
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model#'
        # Larastan types ->pivot on a single model fetched via firstWhere(), but
        # loses it once the relation's collection is iterated/filtered (as here);
        # scoped to this one pivot-reading call site.
        -
            message: '#Access to an undefined property App\\Models\\Employee::\$pivot#'
            path: app/Support/Calendar/TaggedCopies.php
